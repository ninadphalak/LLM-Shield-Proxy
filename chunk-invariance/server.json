  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/ninadphalak/LLM-Shield-Proxy",
    "source": "github",
    "subfolder": "chunk-invariance"
  },
  "websiteUrl": "https://github.com/ninadphalak/LLM-Shield-Proxy/tree/main/chunk-invariance",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "chunk-invariance",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "chunk-invariance[mcp]==0.2.0",
          "description": "The MCP server needs the mcp extra; the core package has no dependencies."
