{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-0039f5fd-ac66-4a1c-9e0.web.app/spec/streaming-privacy-gateway/v1.0.0/http-profile.schema.json",
  "title": "Streaming Privacy Gateway HTTP Profile Report v1.0.0",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "profile",
    "implementation",
    "target",
    "harness_revision",
    "environment",
    "capture",
    "checks",
    "passed",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "llm-shield.streaming-privacy-http-profile/v1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "required": [
        "name",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version",
        "labels_are_operator_supplied"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "labels_are_operator_supplied": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "base_url",
        "model",
        "raw_pass_through_baseline"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "extra_header_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_pass_through_baseline": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "harness_revision": {
      "type": "string",
      "minLength": 1
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "implementation",
        "platform"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "processor": {
          "type": "string"
        }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "bind_host",
        "port"
      ],
      "properties": {
        "bind_host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer"
        },
        "target_must_be_preconfigured_for": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "configured_upstream_boundary",
        "fragmentation_safety",
        "sse_validity",
        "response_fidelity",
        "client_observed_latency"
      ],
      "properties": {
        "configured_upstream_boundary": {
          "$ref": "#/$defs/boundary_check"
        },
        "fragmentation_safety": {
          "$ref": "#/$defs/fragmentation_check"
        },
        "sse_validity": {
          "$ref": "#/$defs/sse_check"
        },
        "response_fidelity": {
          "$ref": "#/$defs/response_check"
        },
        "client_observed_latency": {
          "$ref": "#/$defs/latency_check"
        }
      },
      "additionalProperties": false
    },
    "passed": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "configured_upstream_boundary": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "configured_upstream_boundary"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "fragmentation_safety": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "fragmentation_safety"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "sse_validity": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "sse_validity"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "response_fidelity": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "response_fidelity"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "client_observed_latency": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "client_observed_latency"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "fragmentation_check": {
      "type": "object",
      "required": [
        "passed",
        "one_character_events_requested",
        "events_observed",
        "events_observed_max",
        "coalescing_not_distinguished"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "one_character_events_requested": {"const": true},
        "events_observed": {"type": "integer", "minimum": 0},
        "events_observed_max": {"type": "integer", "minimum": 0},
        "coalescing_not_distinguished": {"const": true}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {"properties": {"events_observed": {"minimum": 2}}},
      "additionalProperties": false
    },
    "sse_check": {
      "type": "object",
      "required": [
        "passed", "invalid_events", "done_markers_valid", "status_codes", "errors"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "invalid_events": {"type": "integer", "minimum": 0},
        "done_markers_valid": {"type": "boolean"},
        "content_type_valid": {"type": "boolean"},
        "status_codes": {"type": "array", "items": {"type": "integer"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "invalid_events": {"const": 0},
          "done_markers_valid": {"const": true},
          "content_type_valid": {"const": true},
          "errors": {"maxItems": 0}
        }
      },
      "additionalProperties": false
    },
    "response_check": {
      "type": "object",
      "required": [
        "passed", "expected_value_reconstructed", "iterations_matching",
        "iterations_completed", "payload_content_included"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "expected_value_reconstructed": {"type": "boolean"},
        "iterations_matching": {"type": "integer", "minimum": 0},
        "iterations_completed": {"type": "integer", "minimum": 0},
        "iterations_requested": {"type": "integer", "minimum": 1},
        "payload_content_included": {"const": false}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "expected_value_reconstructed": {"const": true},
          "iterations_matching": {"minimum": 1},
          "iterations_completed": {"minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "latency_check": {
      "type": "object",
      "required": [
        "passed", "threshold_enforced", "unit", "iterations", "mean", "p50", "p95", "p99"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "threshold_enforced": {"const": false},
        "unit": {"const": "milliseconds"},
        "iterations": {"type": "integer", "minimum": 1},
        "mean": {"type": "number", "minimum": 0},
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "boundary_check": {
      "type": "object",
      "required": [
        "passed",
        "captured_requests",
        "correlated_requests",
        "uninspectable_requests",
        "uninspectable_reasons",
        "leaked_entity_types",
        "upstream_paths_observed",
        "marker_words_required",
        "marker_words_total",
        "inspection_scope",
        "payload_content_included"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "captured_requests": {
          "type": "integer",
          "minimum": 0
        },
        "correlated_requests": {
          "type": "integer",
          "minimum": 0
        },
        "uninspectable_requests": {
          "type": "integer",
          "minimum": 0
        },
        "uninspectable_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "leaked_entity_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upstream_paths_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upstream_methods_observed": {
          "type": "array",
          "items": {"type": "string"}
        },
        "marker_words_required": {
          "type": "integer",
          "minimum": 1
        },
        "marker_words_total": {
          "type": "integer",
          "minimum": 1
        },
        "inspection_scope": {"type": "string", "minLength": 1},
        "payload_content_included": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "leaked_entity_types": {
                "maxItems": 0
              },
              "uninspectable_requests": {
                "const": 0
              },
              "correlated_requests": {
                "minimum": 1
              },
              "captured_requests": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "description": "Self-reported provenance for this run; absent when the harness had no CI context. Independently verified provenance requires a future schema with proof fields.",
      "required": [
        "verification",
        "runner",
        "commit_sha"
      ],
      "properties": {
        "verification": {
          "description": "Values are copied from the run environment and are forgeable by whoever ran the harness. Independently verified mechanisms require a future schema with proof fields.",
          "const": "self-reported"
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "ci_provider": {
          "type": "string",
          "minLength": 1
        },
        "run_url": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}(\\+[A-Za-z0-9._-]+)?$"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
