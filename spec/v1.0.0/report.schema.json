{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-0039f5fd-ac66-4a1c-9e0.web.app/spec/streaming-privacy-gateway/v1.0.0/report.schema.json",
  "title": "Streaming Privacy Gateway Conformance Report v1.0.0",
  "type": "object",
  "required": [
    "schema",
    "specification",
    "generated_at",
    "implementation",
    "source_revision",
    "environment",
    "checks",
    "microbenchmarks",
    "memory",
    "passed",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "llm-shield.streaming-privacy-conformance/v1.0.0"
    },
    "specification": {
      "type": "object",
      "required": [
        "name",
        "version",
        "href"
      ],
      "properties": {
        "name": {
          "const": "Streaming Privacy Gateway Conformance Specification"
        },
        "version": {
          "const": "1.0.0"
        },
        "href": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "implementation",
        "platform"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "processor": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "fragmentation_safety",
        "raw_pii_egress",
        "sse_validity",
        "rehydration_fidelity",
        "audit_integrity",
        "latency_measurement",
        "memory_bounded"
      ],
      "properties": {
        "fragmentation_safety": {
          "$ref": "#/$defs/fragmentation_check"
        },
        "raw_pii_egress": {
          "$ref": "#/$defs/egress_check"
        },
        "sse_validity": {
          "$ref": "#/$defs/sse_check"
        },
        "rehydration_fidelity": {
          "$ref": "#/$defs/rehydration_check"
        },
        "audit_integrity": {
          "$ref": "#/$defs/audit_check"
        },
        "latency_measurement": {
          "$ref": "#/$defs/latency_check"
        },
        "memory_bounded": {
          "$ref": "#/$defs/memory_check"
        }
      },
      "additionalProperties": false
    },
    "microbenchmarks": {
      "type": "object",
      "description": "Measured timings. Required so a report cannot claim latency_measurement passed with no samples behind it.",
      "required": [
        "iterations",
        "scope",
        "unit",
        "no_op",
        "empty_vault_buffer",
        "protected_token_buffer"
      ],
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "const": "nanoseconds"
        },
        "no_op": {
          "$ref": "#/$defs/distribution"
        },
        "empty_vault_buffer": {
          "$ref": "#/$defs/distribution"
        },
        "protected_token_buffer": {
          "$ref": "#/$defs/distribution"
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "description": "Measured allocation figures and the retention bound actually checked.",
      "required": [
        "scope",
        "iterations",
        "current_bytes",
        "peak_bytes",
        "retained_characters",
        "retention_bound_characters"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "current_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "peak_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retained_characters": {
          "type": "integer",
          "minimum": 0
        },
        "retention_bound_characters": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "passed": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/passed_requires_fragmentation_safety"
    },
    {
      "$ref": "#/$defs/passed_requires_raw_pii_egress"
    },
    {
      "$ref": "#/$defs/passed_requires_sse_validity"
    },
    {
      "$ref": "#/$defs/passed_requires_rehydration_fidelity"
    },
    {
      "$ref": "#/$defs/passed_requires_audit_integrity"
    },
    {
      "$ref": "#/$defs/passed_requires_latency_measurement"
    },
    {
      "$ref": "#/$defs/passed_requires_memory_bounded"
    }
  ],
  "$defs": {
    "distribution": {
      "type": "object",
      "required": [
        "mean",
        "p50",
        "p95",
        "p99"
      ],
      "properties": {
        "mean": {"type": "number", "minimum": 0},
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "p99": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "fragmentation_check": {
      "type": "object",
      "required": ["passed", "partitions_tested", "failures", "invariant"],
      "properties": {
        "passed": {"type": "boolean"},
        "partitions_tested": {"type": "integer", "minimum": 1},
        "failures": {"type": "array", "items": {"type": "object"}},
        "invariant": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {"properties": {"failures": {"maxItems": 0}}},
      "additionalProperties": false
    },
    "egress_check": {
      "type": "object",
      "required": [
        "passed",
        "boundary",
        "protected_entity_types",
        "detected_entity_counts",
        "leaked_entity_types",
        "payload_content_included"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "boundary": {"const": "serialized payload presented to the configured upstream"},
        "protected_entity_types": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "CREDIT_CARD"},
            {"const": "EMAIL"},
            {"const": "SSN"}
          ],
          "items": false
        },
        "detected_entity_counts": {
          "type": "object",
          "required": ["EMAIL", "SSN", "CREDIT_CARD"],
          "properties": {
            "EMAIL": {"type": "integer", "minimum": 0},
            "SSN": {"type": "integer", "minimum": 0},
            "CREDIT_CARD": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "leaked_entity_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload_content_included": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "detected_entity_counts": {
                "properties": {
                  "EMAIL": {"minimum": 1},
                  "SSN": {"minimum": 1},
                  "CREDIT_CARD": {"minimum": 1}
                }
              },
              "leaked_entity_types": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "sse_check": {
      "type": "object",
      "required": [
        "passed", "provider_shape", "json_events_checked", "invalid_json_events",
        "done_markers", "stream_terminated_with_blank_line", "utf8_mid_codepoint_split_preserved"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "provider_shape": {"type": "string", "minLength": 1},
        "json_events_checked": {"type": "integer", "minimum": 0},
        "invalid_json_events": {"type": "integer", "minimum": 0},
        "done_markers": {"type": "integer", "minimum": 0},
        "stream_terminated_with_blank_line": {"type": "boolean"},
        "utf8_mid_codepoint_split_preserved": {"type": "boolean"}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "json_events_checked": {"minimum": 1},
          "invalid_json_events": {"const": 0},
          "done_markers": {"const": 1},
          "stream_terminated_with_blank_line": {"const": true},
          "utf8_mid_codepoint_split_preserved": {"const": true}
        }
      },
      "additionalProperties": false
    },
    "rehydration_check": {
      "type": "object",
      "required": [
        "passed", "expected_value_reconstructed", "protected_placeholder_present",
        "payload_content_included"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "expected_value_reconstructed": {"type": "boolean"},
        "protected_placeholder_present": {"type": "boolean"},
        "payload_content_included": {"const": false}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "expected_value_reconstructed": {"const": true},
          "protected_placeholder_present": {"const": false}
        }
      },
      "additionalProperties": false
    },
    "audit_check": {
      "type": "object",
      "required": [
        "passed", "records_verified", "signatures_verified", "sequence_continuity_verified",
        "tamper_negative_control_detected", "record_content_included"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "records_verified": {"type": "integer", "minimum": 1},
        "signatures_verified": {"type": "integer", "minimum": 0},
        "sequence_continuity_verified": {"type": "boolean"},
        "tamper_negative_control_detected": {"type": "boolean"},
        "record_content_included": {"const": false}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "signatures_verified": {"minimum": 1},
          "sequence_continuity_verified": {"const": true},
          "tamper_negative_control_detected": {"const": true}
        }
      },
      "additionalProperties": false
    },
    "latency_check": {
      "type": "object",
      "required": ["passed", "threshold_enforced", "samples_per_operation", "scope"],
      "properties": {
        "passed": {"type": "boolean"},
        "threshold_enforced": {"const": false},
        "samples_per_operation": {"type": "integer", "minimum": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "memory_check": {
      "type": "object",
      "required": [
        "passed", "rss_threshold_enforced", "allocation_measurement_recorded",
        "retention_bound_verified"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "rss_threshold_enforced": {"const": false},
        "allocation_measurement_recorded": {"type": "boolean"},
        "retention_bound_verified": {"type": "boolean"}
      },
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "allocation_measurement_recorded": {"const": true},
          "retention_bound_verified": {"const": true}
        }
      },
      "additionalProperties": false
    },
    "passed_requires_fragmentation_safety": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "fragmentation_safety": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "fragmentation_safety"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "passed_requires_raw_pii_egress": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "raw_pii_egress": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "raw_pii_egress"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "passed_requires_sse_validity": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "sse_validity": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "sse_validity"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "passed_requires_rehydration_fidelity": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "rehydration_fidelity": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "rehydration_fidelity"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "passed_requires_audit_integrity": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "audit_integrity": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "audit_integrity"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "passed_requires_latency_measurement": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "latency_measurement": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "latency_measurement"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "passed_requires_memory_bounded": {
      "if": {
        "properties": {
          "checks": {
            "properties": {
              "memory_bounded": {
                "properties": {
                  "passed": {
                    "const": false
                  }
                },
                "required": [
                  "passed"
                ]
              }
            },
            "required": [
              "memory_bounded"
            ]
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "description": "Self-reported provenance for this run; absent when the harness had no CI context. Independently verified provenance requires a future schema with proof fields.",
      "required": [
        "verification",
        "runner",
        "commit_sha"
      ],
      "properties": {
        "verification": {
          "description": "Values are copied from the run environment and are forgeable by whoever ran the harness. Independently verified mechanisms require a future schema with proof fields.",
          "const": "self-reported"
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "ci_provider": {
          "type": "string",
          "minLength": 1
        },
        "run_url": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}(\\+[A-Za-z0-9._-]+)?$"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
