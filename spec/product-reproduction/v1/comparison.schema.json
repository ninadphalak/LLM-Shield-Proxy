{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmshieldproxy.com/spec/product-reproduction/v1/comparison.schema.json",
  "title": "Released product baseline comparison",
  "type": "object",
  "required": ["schema", "policy", "target_id", "mode", "profiles"],
  "properties": {
    "schema": {"const": "pii-leak-benchmark/product-comparison/v1"},
    "policy": {"const": "product-reproduction/v1"},
    "target_id": {"$ref": "#/$defs/safeId"},
    "mode": {"enum": ["measure", "reproduce"]},
    "baseline_id": {"$ref": "#/$defs/safeId"},
    "artifact_identity_match": {"type": "boolean"},
    "configuration_match": {"type": "boolean"},
    "profiles": {
      "type": "object",
      "required": ["operator", "response-midpoint"],
      "properties": {
        "operator": {"$ref": "#/$defs/profileComparison"},
        "response-midpoint": {"$ref": "#/$defs/profileComparison"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "reproduce"}}},
      "then": {"required": ["baseline_id", "artifact_identity_match", "configuration_match"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["baseline_id"]},
            {"required": ["artifact_identity_match"]},
            {"required": ["configuration_match"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "measure"}}},
      "then": {
        "properties": {
          "profiles": {
            "properties": {
              "operator": {"properties": {"status": {"const": "not-compared"}}},
              "response-midpoint": {"properties": {"status": {"const": "not-compared"}}}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100},
    "profileComparison": {
      "type": "object",
      "required": ["status", "level", "differences"],
      "properties": {
        "status": {"enum": ["matched", "drifted", "not-compared", "invalid"]},
        "level": {"enum": ["exact", "primary", "none"]},
        "current_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "differences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$", "maxLength": 300}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["matched", "drifted"]}}},
          "then": {
            "required": ["current_sha256", "baseline_sha256"],
            "properties": {"level": {"enum": ["exact", "primary"]}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "not-compared"}}},
          "then": {
            "required": ["current_sha256"],
            "properties": {"level": {"const": "none"}},
            "not": {"required": ["baseline_sha256"]}
          }
        },
        {
          "if": {"properties": {"status": {"const": "invalid"}}},
          "then": {"properties": {"level": {"const": "none"}}}
        },
        {
          "if": {"properties": {"level": {"const": "exact"}}},
          "then": {
            "properties": {
              "status": {"const": "matched"},
              "differences": {"maxItems": 0}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
