{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmshieldproxy.com/spec/product-reproduction/v1/submission.schema.json",
  "title": "Released product wall submission metadata",
  "type": "object",
  "required": [
    "schema",
    "gateway",
    "requested_release_selector",
    "version",
    "artifact_identity",
    "release_url",
    "configuration_id",
    "configuration_sha256",
    "project_url",
    "run_url",
    "architecture",
    "license",
    "mode",
    "bundle_manifest_sha256",
    "report_paths"
  ],
  "properties": {
    "schema": {"const": "pii-leak-benchmark/submission/v2"},
    "gateway": {"type": "string", "minLength": 1, "maxLength": 160},
    "requested_release_selector": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "artifact_identity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "release_url": {"$ref": "#/$defs/httpsUrl"},
    "configuration_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "project_url": {"$ref": "#/$defs/httpsUrl"},
    "run_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$"},
    "architecture": {"enum": ["per-chunk", "buffered", "held-tail", "none", "not-stated"]},
    "license": {"type": "string", "pattern": "^[A-Za-z0-9.+()-]+$", "maxLength": 100},
    "mode": {"enum": ["measure", "reproduce"]},
    "baseline": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 100},
        "status": {"enum": ["accepted", "candidate"]}
      },
      "additionalProperties": false
    },
    "bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "report_paths": {
      "type": "object",
      "required": ["operator", "operator_raw", "response_midpoint", "comparison"],
      "properties": {
        "operator": {"$ref": "#/$defs/memberPath"},
        "operator_raw": {"$ref": "#/$defs/memberPath"},
        "response_midpoint": {"$ref": "#/$defs/memberPath"},
        "comparison": {"$ref": "#/$defs/memberPath"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "reproduce"}}},
      "then": {"required": ["baseline"]}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "httpsUrl": {"type": "string", "format": "uri", "pattern": "^https://[^@/?#\\s]+(?:/[^?#\\s]*)?$", "maxLength": 500},
    "memberPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "maxLength": 500
    }
  }
}
