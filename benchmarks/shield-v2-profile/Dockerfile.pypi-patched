# HISTORICAL. Kept so the 1.5.1 measurement stays reproducible; use Dockerfile.pypi for
# current runs.
#
# `pip install llm-shield-proxy==1.5.1` alone cannot be profiled at all: every proxied
# request 500s on `import jwt`, because PyJWT is imported at module scope by
# security/identity.py and is NOT in that wheel's requires_dist. This image adds PyJWT as
# an EXPLICIT, DECLARED deviation, which is how 1.5.1 was scored on redaction behaviour
# rather than on a packaging outage.
#
# 1.5.2 declares PyJWT, so it needs no deviation and Dockerfile.pypi builds it directly.
# The two score identically, which is the evidence that the fix was packaging-only.
FROM python:3.12-slim

ARG SHIELD_VERSION=1.5.1

RUN pip install --no-cache-dir "llm-shield-proxy==${SHIELD_VERSION}" "uvicorn[standard]" \
    && pip install --no-cache-dir "PyJWT>=2.13.0"

RUN pip freeze > /installed-requirements.txt

EXPOSE 8000

ENTRYPOINT ["uvicorn", "llm_shield_proxy.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
