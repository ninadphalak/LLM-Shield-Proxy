{
  "schema": "pii-leak-benchmark/product-configuration/v1",
  "configuration_id": "response-redaction-on-v1",
  "container_port": 8000,
  "environment": {
    "ALLOW_CLIENT_UPSTREAM_OVERRIDE": "false",
    "ENABLE_DEEP_PAYLOAD_REDACTION": "true",
    "ENABLE_OPEN_BYOK_PASSTHROUGH": "false",
    "ENABLE_RESPONSE_PII_REDACTION": "true",
    "ENABLE_RETRY_FAILOVER": "false",
    "ENABLE_TIER3_ONNX_NER": "false",
    "MAX_RETRIES": "0",
    "OPENAI_API_KEY": "{{SYNTHETIC_UPSTREAM_KEY}}",
    "SHIELD_DEFAULT_MASKING_MODE": "SYNTHETIC",
    "SHIELD_FAILURE_MODE": "FAIL_CLOSED",
    "UPSTREAM_API_KEY": "{{SYNTHETIC_UPSTREAM_KEY}}",
    "UPSTREAM_BASE_URL": "{{CAPTURE_BASE_URL}}",
    "VALID_VIRTUAL_KEYS": "{{SYNTHETIC_VIRTUAL_KEY}}"
  },
  "functional_identity": {
    "model": "capture",
    "fallback_configured": false,
    "retry_failover": false,
    "request_path_deep_redaction": true,
    "response_pii_redaction": true,
    "tier3_onnx_ner": false,
    "virtual_key_auth": "allowlist"
  },
  "required_substitutions": [
    "CAPTURE_BASE_URL",
    "SYNTHETIC_UPSTREAM_KEY",
    "SYNTHETIC_VIRTUAL_KEY"
  ]
}
