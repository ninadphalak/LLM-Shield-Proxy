# LLM-Shield-Proxy Environment Configuration

# 1. Choose your Upstream Provider URL
# OpenAI (Default):  https://api.openai.com
# Google Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
# DeepSeek:          https://api.deepseek.com/v1
# Groq:              https://api.groq.com/openai/v1
UPSTREAM_BASE_URL=https://api.openai.com

# 2. Centralized API Keys (Optional)
# If a client passes their own real API key in their request (BYOK mode), the proxy
# will pass it through untouched.
# If a client passes no key (or a dummy key), the proxy will inject the appropriate
# centralized key below based on the routing destination.
UPSTREAM_API_KEY=your-default-api-key-here
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key
# ANTHROPIC_API_KEY=your-anthropic-key
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT_URL=https://your-telemetry-endpoint.example.com/rest/v1/telemetry_logs
TELEMETRY_API_KEY=your-telemetry-api-key
